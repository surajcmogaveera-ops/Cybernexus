# PostgreSQL connection used by Prisma. A local database is not required for frontend development.
# Add the username/password required by your local PostgreSQL configuration in .env.
DATABASE_URL=postgresql://localhost:5432/cybernexus?schema=public
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
# JSON array of configured bearer credentials; use high-entropy tokens and keep actual values in ignored .env.
CYBERNEXUS_API_TOKENS_JSON=
# Internal AI API; keep private and do not expose through the frontend.
AI_SERVICE_URL=http://127.0.0.1:8000
CYBERNEXUS_AI_SERVICE_TOKEN=
# Optional QpiAI integrations are not configured in this scaffold.
QPIAI_AGENT_HIVE_API_KEY=
QPIAI_OPT_BASE_URL=https://opt-server.qpiai.tech/api
QPIAI_OPT_API_TOKEN=YOUR_QPIAI_OPT_API_TOKEN
