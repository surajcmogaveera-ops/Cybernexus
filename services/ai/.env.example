# Copy to services/ai/.env; keep Gemini settings in the FastAPI service only.
# Keep this disabled until account/application eligibility and data-use review.
AI_PROVIDER=deterministic
GEMINI_LIVE_ENABLED=false
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
# Must match CYBERNEXUS_AI_SERVICE_TOKEN configured for the Express API.
CYBERNEXUS_AI_SERVICE_TOKEN=
